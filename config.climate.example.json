{
  "listen": "127.0.0.1:8443",
  "upstream": "wss://uniproxy.alice.yandex.net/uni.ws",
  "mode": "local",
  "allowed_ips": [
    "127.0.0.1",
    "::1"
  ],
  "listen_after_reply": false,
  "airplay": {
    "disabled": true
  },
  "assistant_tools": {
    "enabled": false
  },
  "dialogue_context": {
    "enabled": false
  },
  "conversation_log": {
    "enabled": false
  },
  "routing": {
    "rules": [],
    "default_route": "yandex",
    "classifier": {
      "enabled": false
    },
    "refusal": {
      "enabled": false
    }
  },
  "direct_ha": {
    "url": "http://192.168.1.11:8123",
    "rules": [
      {
        "phrases": [
          "включи свет"
        ],
        "domain": "switch",
        "service": "turn_on",
        "entity_id": "switch.cabinet"
      },
      {
        "phrases": [
          "выключи свет"
        ],
        "domain": "switch",
        "service": "turn_off",
        "entity_id": "switch.cabinet"
      },
      {
        "phrases": [
          "включи вентиляцию"
        ],
        "domain": "switch",
        "service": "turn_on",
        "entity_id": "switch.ventiliatsiia"
      },
      {
        "phrases": [
          "выключи вентиляцию"
        ],
        "domain": "switch",
        "service": "turn_off",
        "entity_id": "switch.ventiliatsiia"
      },
      {
        "phrases": [
          "включи ночник"
        ],
        "domain": "switch",
        "service": "turn_on",
        "entity_id": "switch.nochnik"
      },
      {
        "phrases": [
          "выключи ночник"
        ],
        "domain": "switch",
        "service": "turn_off",
        "entity_id": "switch.nochnik"
      },
      {
        "phrases": [
          "включи кондиционер на обогрев"
        ],
        "domain": "climate",
        "service": "set_temperature",
        "entity_id": "climate.cabinet_ac",
        "hvac_mode": "heat",
        "temperature": 26,
        "fan_mode": "low"
      },
      {
        "phrases": [
          "включи кондиционер на охлаждение"
        ],
        "domain": "climate",
        "service": "set_temperature",
        "entity_id": "climate.cabinet_ac",
        "hvac_mode": "cool",
        "temperature": 24,
        "fan_mode": "low"
      },
      {
        "phrases": [
          "выключи кондиционер"
        ],
        "domain": "climate",
        "service": "turn_off",
        "entity_id": "climate.cabinet_ac"
      }
    ]
  }
}
